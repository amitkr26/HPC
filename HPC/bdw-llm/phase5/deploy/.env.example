# P5.1 example environment — copy to `.env` and fill in.
#   cp .env.example .env   &&   chmod 600 .env
# `.env` is gitignored. NEVER commit real values; secrets live in the
# operator secret store / Cloudflare dashboard, pasted at deploy time.

# ---------------------------------------------------------------- vLLM ----
# Default: official image. PRODUCTION: pin to a digest, e.g.
#   VLLM_IMAGE=ghcr.io/vllm-project/vllm-openai@sha256:<digest>
VLLM_IMAGE=ghcr.io/vllm-project/vllm-openai:latest
# Heavy model decision (blueprint §8): Qwen2.5-72B (open weights, default)
# or Llama-3.3-70B-Instruct (gated on HF -> requires HF_TOKEN below).
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# 2 = H100/A100 budget tier (~8k ctx); 4 = recommended tier (32k ctx).
TP_SIZE=2
MAX_MODEL_LEN=8192
VLLM_DTYPE=auto
VLLM_GPU_MEM_UTIL=0.92
# Only for gated models (Llama 3.3). Qwen2.5-72B needs none. HF token is
# a read token scoped to model downloads — not an account password.
HF_TOKEN=

# -------------------------------------------------------------- shim ------
# The single shared bearer key for BDW callers (ai-gateway BDW_API_KEY).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
P5_API_KEY=
P5_AUTH_MODE=required
P5_MODEL=bdw-career-ai
# P5.1: live ask_stream() proxy when the gateway supports it (true/false).
P5_STREAM_UPSTREAM=true
# P5.1: optional bearer for GET /metrics (empty = endpoint open on the
# private network; the edge blocks /metrics anyway). Independent of P5_API_KEY.
P5_METRICS_TOKEN=
P5_SSE_HEARTBEAT_S=10

# -------------------------------------------------------------- Zone 3 ----
# Compose sets these; shown for reference / non-compose runs.
# ZONE3_BASE_URL=http://vllm:8000
# 70B prefill is slow — 15s default is too low (cluster lesson).
ZONE3_TIMEOUT_S=300

# --------------------------------------------------- data mounts (host) ----
# Directories baked/staged on the host (cluster copies), mounted read-only:
#   RAG_DIR -> /data/rag   (Phase 4 RAG artifacts, FAQ/corpus JSON)
#   BGE_DIR -> /data/bge   (staged BGE-small embedder)
RAG_DIR=
BGE_DIR=
P4_DOMAIN_BACKEND=file
# Optional Supabase-backed routing/FAQ source:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------- tunnel -------
# Dashboard-managed tunnel token (CLOUDFLARE_TUNNEL.md step 5). Required.
TUNNEL_TOKEN=
