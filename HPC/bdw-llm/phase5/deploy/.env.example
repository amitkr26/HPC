# P5.1 environment configuration for Param Rudra ($0 Zero-Cost Production Stack)
#   cp .env.example .env   &&   chmod 600 .env
#
# NEVER commit real secret values to git.
# This file is documentation and template only.

# ---------------------------------------------------------------- vLLM ----
# Frontier 70B Model to run on CDAC Param Rudra compute nodes (rdgpu01 / rdgpu02).
# 2x NVIDIA A100 80GB PCIe GPUs = 160 GB total VRAM.
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# Tensor Parallelism: 2 splits across both A100 80GB GPUs
TP_SIZE=2
MAX_MODEL_LEN=8192
VLLM_DTYPE=auto
VLLM_GPU_MEM_UTIL=0.92

# Optional HF Token: only needed if using gated models (like Llama-3.3-70B-Instruct).
# Qwen2.5-72B-Instruct has fully open weights and requires NO token.
HF_TOKEN=

# -------------------------------------------------------------- shim ------
# The single shared bearer key for BDW callers (ai-gateway BDW_API_KEY).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
P5_API_KEY=
P5_AUTH_MODE=required
P5_MODEL=bdw-career-ai
# Live ask_stream() proxy for real-time SSE token streaming
P5_STREAM_UPSTREAM=true
# Optional bearer token for GET /metrics (Prometheus scraping)
P5_METRICS_TOKEN=
P5_SSE_HEARTBEAT_S=10

# -------------------------------------------------------------- Zone 3 ----
# Local upstream vLLM URL and timeout
ZONE3_BASE_URL=http://127.0.0.1:8000/v1
# 70B prefill can take a few seconds on cold queries
ZONE3_TIMEOUT_S=300

# --------------------------------------------------- data & RAG mounts ----
# Supabase domain retrieval backend for math, vlsi, embedded, cs, aiml
P4_DOMAIN_BACKEND=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ----------------------------------------------------------- tunnel -------
# Cloudflare Zero Trust Tunnel Token.
# Bypasses CDAC firewall to expose the shim at https://ai.berojgardegreewala.com.
# Generated from Cloudflare Dashboard -> Zero Trust -> Networks -> Tunnels.
TUNNEL_TOKEN=
