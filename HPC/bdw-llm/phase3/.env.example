# Phase 3 env contract — NAMES ONLY; values live in the owner's secret store
# and are never committed (S1). The gateway (Zone 2) holds the service key;
# the browser bundle must contain none of these.

# --- Zone 4 Supabase (gateway-side only) ---
SUPABASE_URL=                # project URL, e.g. https://<ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # service-role; bypasses RLS; never public (S1)

# --- Zone 3 inference (internal; never exposed to the browser, S1) ---
ZONE3_BASE_URL=              # e.g. http://llama:8080 on the internal network
ZONE3_MODEL_PATH=            # path to bdw-7b-sft-Q4_K_M.gguf (mounted read-only)
ZONE3_MODEL_MD5=c681fafe042ca8277fc08c526cc6de8b   # published, not secret (S8 gate)
ZONE3_THREADS=4              # 4-8 per the P3.2 measurement
ZONE3_TIMEOUT_S=15           # hard generation cap (BDW_INTEGRATION.md §6)

# --- Retrieval / embeddings ---
BGE_MODEL_DIR=               # local dir with bge-small-en-v1.5 (384-d)
RETRIEVAL_TOPK=20            # rerank window; top-2 assembled into the prompt
BM25_WEIGHT=0.5              # reciprocal-rank-fusion weight vs cosine (§7.2)

# --- Quotas / limits (S7; generalises the existing 35/35 Lab Tools quota) ---
RATE_LIMIT_PER_USER_DAY=35
MAX_TOKENS=1024
